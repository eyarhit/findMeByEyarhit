
model Model
    culture: fr-FR
    defaultPowerBIDataSourceVersion: powerBI_V3

    annotation PBI_QueryOrder = ["PBI_MySqlServer","PBI_MySqlDatabase","dim_date","dim_user","dim_user_scd2","dim_mission","dim_skill","fact_user","fact_notification","fact_mission","fact_candidature","fact_mission_favori","fact_cv","fact_quiz","fact_codingame","etl_run_log","v_bi_candidature","v_bi_mission","v_bi_kpi_recrutement"]

expression PBI_MySqlServer = "localhost:3306" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
expression PBI_MySqlDatabase = "findme_dw" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

ref table dim_date
ref table dim_user
ref table dim_user_scd2
ref table dim_mission
ref table dim_skill
ref table fact_user
ref table fact_notification
ref table fact_mission
ref table fact_candidature
ref table fact_mission_favori
ref table fact_cv
ref table fact_quiz
ref table fact_codingame
ref table etl_run_log
ref table v_bi_candidature
ref table v_bi_mission
ref table v_bi_kpi_recrutement

ref relationship rel_fact_notification_date_key
ref relationship rel_fact_mission_mission_key
ref relationship rel_fact_mission_date_key
ref relationship rel_fact_candidature_date_key
ref relationship rel_fact_candidature_mission_key
ref relationship rel_fact_mission_favori_date_key
ref relationship rel_fact_mission_favori_mission_key
ref relationship rel_fact_cv_date_key
ref relationship rel_fact_cv_user_key
ref relationship rel_fact_quiz_date_key
ref relationship rel_fact_quiz_user_key
ref relationship rel_fact_codingame_date_key
ref relationship rel_fact_codingame_user_key
ref relationship rel_fact_user_user_key
ref relationship rel_v_bi_kpi_recrutement_year_num
ref relationship rel_v_bi_candidature_year_num
ref relationship rel_v_bi_mission_year_num
