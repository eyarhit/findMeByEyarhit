
table fact_notification
    lineageTag: 46ea9063-381f-4275-8fd5-438d41939614

    column notification_key
        dataType: int64
        sourceColumn: notification_key
        summarizeBy: none

    column date_key
        dataType: int64
        sourceColumn: date_key
        summarizeBy: none

    column user_id_degen
        dataType: string
        sourceColumn: user_id_degen
        summarizeBy: none

    column is_read
        dataType: int64
        sourceColumn: is_read
        summarizeBy: none

    column notification_count
        dataType: int64
        sourceColumn: notification_count
        summarizeBy: sum

    partition fact_notification = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="fact_notification"]}[Data]
                    otherwise try Source{[Name="fact_notification", Kind="Table"]}[Data]
                    otherwise try Source{[Item="fact_notification"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM fact_notification", null)
            in
                Data
