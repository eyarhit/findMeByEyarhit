
table fact_notification
    lineageTag: b25eebeb-7be6-4c59-adc4-333d0c13c274

    column notification_key
        dataType: int64
        sourceColumn: notification_key
        summarizeBy: none

    column date_key
        dataType: int64
        sourceColumn: date_key
        summarizeBy: none

    column user_id_degen
        dataType: string
        sourceColumn: user_id_degen
        summarizeBy: none

    column is_read
        dataType: int64
        sourceColumn: is_read
        summarizeBy: none

    column notification_count
        dataType: int64
        sourceColumn: notification_count
        summarizeBy: sum

    partition fact_notification = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = Source{[Schema=PBI_MySqlDatabase, Item="fact_notification"]}[Data]
            in
                Data
