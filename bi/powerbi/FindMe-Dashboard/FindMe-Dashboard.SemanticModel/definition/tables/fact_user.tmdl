
table fact_user
    lineageTag: 88d59764-0fbc-45a8-bc41-387f4ce49028

    column user_key
        dataType: int64
        sourceColumn: user_key
        summarizeBy: none

    column user_count
        dataType: int64
        sourceColumn: user_count
        summarizeBy: sum

    partition fact_user = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="fact_user"]}[Data]
                    otherwise try Source{[Name="fact_user", Kind="Table"]}[Data]
                    otherwise try Source{[Item="fact_user"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM fact_user", null)
            in
                Data
