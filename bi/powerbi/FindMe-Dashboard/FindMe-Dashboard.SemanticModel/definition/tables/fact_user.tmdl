
table fact_user
    lineageTag: 0ec6d3ee-a724-4caf-b6b4-0b20653cfcff

    column user_key
        dataType: int64
        sourceColumn: user_key
        summarizeBy: none

    column user_count
        dataType: int64
        sourceColumn: user_count
        summarizeBy: sum

    partition fact_user = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = Source{[Schema=PBI_MySqlDatabase, Item="fact_user"]}[Data]
            in
                Data
