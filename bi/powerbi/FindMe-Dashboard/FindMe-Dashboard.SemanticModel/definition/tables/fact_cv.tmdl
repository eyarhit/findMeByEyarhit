
table fact_cv
    lineageTag: 6868c1f9-f528-402e-974e-072267ce661d

    column cv_key
        dataType: int64
        sourceColumn: cv_key
        summarizeBy: none

    column date_key
        dataType: int64
        sourceColumn: date_key
        summarizeBy: none

    column user_key
        dataType: int64
        sourceColumn: user_key
        summarizeBy: none

    column cv_count
        dataType: int64
        sourceColumn: cv_count
        summarizeBy: sum

    column steps_completed
        dataType: int64
        sourceColumn: steps_completed
        summarizeBy: sum

    partition fact_cv = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = Source{[Schema=PBI_MySqlDatabase, Item="fact_cv"]}[Data]
            in
                Data
