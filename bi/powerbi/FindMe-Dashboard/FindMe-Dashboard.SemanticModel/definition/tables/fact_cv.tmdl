
table fact_cv
    lineageTag: 0f9cb3db-7a9b-4253-ac0c-6ead83fc3d7d

    column cv_key
        dataType: int64
        sourceColumn: cv_key
        summarizeBy: none

    column date_key
        dataType: int64
        sourceColumn: date_key
        summarizeBy: none

    column user_key
        dataType: int64
        sourceColumn: user_key
        summarizeBy: none

    column cv_count
        dataType: int64
        sourceColumn: cv_count
        summarizeBy: sum

    column steps_completed
        dataType: int64
        sourceColumn: steps_completed
        summarizeBy: sum

    partition fact_cv = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="fact_cv"]}[Data]
                    otherwise try Source{[Name="fact_cv", Kind="Table"]}[Data]
                    otherwise try Source{[Item="fact_cv"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM fact_cv", null)
            in
                Data
