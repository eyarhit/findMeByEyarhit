    column session_count
        dataType: int64
        sourceColumn: session_count
        summarizeBy: sum

    partition fact_codingame = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="fact_codingame"]}[Data]
                    otherwise try Source{[Name="fact_codingame", Kind="Table"]}[Data]
                    otherwise try Source{[Item="fact_codingame"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM fact_codingame", null)
