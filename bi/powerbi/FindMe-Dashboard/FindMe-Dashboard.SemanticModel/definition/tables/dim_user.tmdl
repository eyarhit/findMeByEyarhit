
table dim_user
    lineageTag: fcdc1ee8-0c2a-4ed1-9984-ac21ce476848

    column user_key
        dataType: int64
        sourceColumn: user_key
        summarizeBy: none

    column user_id
        dataType: int64
        sourceColumn: user_id
        summarizeBy: none

    column role_name
        dataType: string
        sourceColumn: role_name
        summarizeBy: none

    column status_name
        dataType: string
        sourceColumn: status_name
        summarizeBy: none

    column country
        dataType: string
        sourceColumn: country
        summarizeBy: none

    column sexe
        dataType: string
        sourceColumn: sexe
        summarizeBy: none

    partition dim_user = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="dim_user"]}[Data]
                    otherwise try Source{[Name="dim_user", Kind="Table"]}[Data]
                    otherwise try Source{[Item="dim_user"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM dim_user", null)
            in
                Data
