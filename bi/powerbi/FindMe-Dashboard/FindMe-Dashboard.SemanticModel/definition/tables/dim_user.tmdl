
table dim_user
    lineageTag: 9d0a7362-7d6e-4cc0-83f2-b7e0330a5cf4

    column user_key
        dataType: int64
        sourceColumn: user_key
        summarizeBy: none

    column user_id
        dataType: int64
        sourceColumn: user_id
        summarizeBy: none

    column role_name
        dataType: string
        sourceColumn: role_name
        summarizeBy: none

    column status_name
        dataType: string
        sourceColumn: status_name
        summarizeBy: none

    column country
        dataType: string
        sourceColumn: country
        summarizeBy: none

    column sexe
        dataType: string
        sourceColumn: sexe
        summarizeBy: none

    partition dim_user = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="dim_user"]}[Data]
                    otherwise try Source{[Name="dim_user", Kind="Table"]}[Data]
                    otherwise try Source{[Item="dim_user"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM dim_user", null)            in
                Data
