
table fact_mission
    lineageTag: 4449065d-20af-4577-8049-a0a13e4a2e22

    column mission_key
        dataType: int64
        sourceColumn: mission_key
        summarizeBy: none

    column date_key
        dataType: int64
        sourceColumn: date_key
        summarizeBy: none

    column publisher_user_id
        dataType: int64
        sourceColumn: publisher_user_id
        summarizeBy: none

    column mission_count
        dataType: int64
        sourceColumn: mission_count
        summarizeBy: sum

    partition fact_mission = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="fact_mission"]}[Data]
                    otherwise try Source{[Name="fact_mission", Kind="Table"]}[Data]
                    otherwise try Source{[Item="fact_mission"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM fact_mission", null)
            in
                Data
