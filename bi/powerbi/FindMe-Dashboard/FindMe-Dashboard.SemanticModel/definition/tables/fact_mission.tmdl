
table fact_mission
    lineageTag: a2b8f068-3ee7-4afd-a09e-ffeb98c799b9

    column mission_key
        dataType: int64
        sourceColumn: mission_key
        summarizeBy: none

    column date_key
        dataType: int64
        sourceColumn: date_key
        summarizeBy: none

    column publisher_user_id
        dataType: int64
        sourceColumn: publisher_user_id
        summarizeBy: none

    column mission_count
        dataType: int64
        sourceColumn: mission_count
        summarizeBy: sum

    partition fact_mission = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = Source{[Schema=PBI_MySqlDatabase, Item="fact_mission"]}[Data]
            in
                Data
