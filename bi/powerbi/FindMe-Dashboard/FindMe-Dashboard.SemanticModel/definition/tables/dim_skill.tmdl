
table dim_skill
    lineageTag: 45453e79-6920-4fc4-93ef-38ae70df44bd

    column skill_key
        dataType: int64
        sourceColumn: skill_key
        summarizeBy: none

    column skill_label
        dataType: string
        sourceColumn: skill_label
        summarizeBy: none

    column skill_category
        dataType: string
        sourceColumn: skill_category
        summarizeBy: none

    column usage_count
        dataType: int64
        sourceColumn: usage_count
        summarizeBy: sum

    partition dim_skill = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="dim_skill"]}[Data]
                    otherwise try Source{[Name="dim_skill", Kind="Table"]}[Data]
                    otherwise try Source{[Item="dim_skill"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM dim_skill", null)
            in
                Data
