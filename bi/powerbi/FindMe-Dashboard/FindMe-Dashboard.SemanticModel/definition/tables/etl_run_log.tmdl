
table etl_run_log
    lineageTag: bc554f0f-f80b-4fc3-8dcd-0089a5c712e6

    column run_id
        dataType: int64
        sourceColumn: run_id
        summarizeBy: none

    column started_at
        dataType: dateTime
        sourceColumn: started_at
        summarizeBy: none

    column finished_at
        dataType: dateTime
        sourceColumn: finished_at
        summarizeBy: none

    column status
        dataType: string
        sourceColumn: status
        summarizeBy: none

    column rows_loaded
        dataType: int64
        sourceColumn: rows_loaded
        summarizeBy: sum

    column error_message
        dataType: string
        sourceColumn: error_message
        summarizeBy: none

    partition etl_run_log = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="etl_run_log"]}[Data]
                    otherwise try Source{[Name="etl_run_log", Kind="Table"]}[Data]
                    otherwise try Source{[Item="etl_run_log"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM etl_run_log", null)
            in
                Data
