
table etl_run_log
    lineageTag: a882add1-fb1e-4f29-af97-f238b765f87b

    column run_id
        dataType: int64
        sourceColumn: run_id
        summarizeBy: none

    column started_at
        dataType: dateTime
        sourceColumn: started_at
        summarizeBy: none

    column finished_at
        dataType: dateTime
        sourceColumn: finished_at
        summarizeBy: none

    column status
        dataType: string
        sourceColumn: status
        summarizeBy: none

    column rows_loaded
        dataType: int64
        sourceColumn: rows_loaded
        summarizeBy: sum

    column error_message
        dataType: string
        sourceColumn: error_message
        summarizeBy: none

    partition etl_run_log = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = Source{[Schema=PBI_MySqlDatabase, Item="etl_run_log"]}[Data]
            in
                Data
