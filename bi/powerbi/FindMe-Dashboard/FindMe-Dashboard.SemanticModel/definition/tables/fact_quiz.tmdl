
table fact_quiz
    lineageTag: 9e61d8fb-c568-4c06-9d5f-cf41b8cdd4e2

    column quiz_key
        dataType: int64
        sourceColumn: quiz_key
        summarizeBy: none

    column date_key
        dataType: int64
        sourceColumn: date_key
        summarizeBy: none

    column user_key
        dataType: int64
        sourceColumn: user_key
        summarizeBy: none

    column score
        dataType: int64
        sourceColumn: score
        summarizeBy: sum

    column passed
        dataType: int64
        sourceColumn: passed
        summarizeBy: none

    column attempt_count
        dataType: int64
        sourceColumn: attempt_count
        summarizeBy: sum

    partition fact_quiz = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = Source{[Schema=PBI_MySqlDatabase, Item="fact_quiz"]}[Data]
            in
                Data
