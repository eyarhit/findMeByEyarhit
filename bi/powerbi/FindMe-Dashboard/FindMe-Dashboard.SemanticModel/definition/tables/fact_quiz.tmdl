
table fact_quiz
    lineageTag: 30d8b4ce-f350-4878-85a0-ec6dd49ee37e

    column quiz_key
        dataType: int64
        sourceColumn: quiz_key
        summarizeBy: none

    column date_key
        dataType: int64
        sourceColumn: date_key
        summarizeBy: none

    column user_key
        dataType: int64
        sourceColumn: user_key
        summarizeBy: none

    column score
        dataType: int64
        sourceColumn: score
        summarizeBy: sum

    column passed
        dataType: int64
        sourceColumn: passed
        summarizeBy: none

    column attempt_count
        dataType: int64
        sourceColumn: attempt_count
        summarizeBy: sum

    partition fact_quiz = m
        mode: import
        source =
            let
                Source = MySQL.Database(PBI_MySqlServer, PBI_MySqlDatabase),
                Data = try Source{[Schema=PBI_MySqlDatabase, Item="fact_quiz"]}[Data]
                    otherwise try Source{[Name="fact_quiz", Kind="Table"]}[Data]
                    otherwise try Source{[Item="fact_quiz"]}[Data]
                    otherwise Value.NativeQuery(Source, "SELECT * FROM fact_quiz", null)
            in
                Data
