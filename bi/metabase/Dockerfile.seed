FROM python:3.12-slim

WORKDIR /app

COPY requirements-seed.txt ./
RUN pip install --no-cache-dir -r requirements-seed.txt

COPY seed_metabase.py ./
COPY sql ./sql

ENV BI_MANIFEST_PATH=/output/bi-manifest.json

CMD ["sh", "-c", "attempt=1; max=8; until python seed_metabase.py; do if [ \"$attempt\" -ge \"$max\" ]; then echo 'Seed failed after retries'; exit 1; fi; echo \"Retry seed in 15s (attempt $attempt/$max)\"; attempt=$((attempt+1)); sleep 15; done"]
